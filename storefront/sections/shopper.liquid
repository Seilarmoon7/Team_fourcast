{{ 'shopper.css' | asset_url | stylesheet_tag }}

<aside
  class="shopper"
  id="Shopper"
  aria-label="{{ section.settings.heading | escape }}"
  data-agent="{{ section.settings.agent_url | escape }}"
  data-email="{{ customer.email | escape }}"
  data-template="{{ template.name }}"
>
  <div class="shopper__head">
    <h2 class="shopper__title">{{ section.settings.heading }}</h2>
    <p class="shopper__sub">{{ section.settings.subheading }}</p>
    <div class="shopper__viewas" data-viewas><span>View as</span></div>
  </div>
  <div class="shopper__log" data-log aria-live="polite"></div>
  <form class="shopper__bar" data-form>
    <input class="shopper__input" data-input aria-label="Message" placeholder="Tell me about the room" maxlength="2000">
    <button class="shopper__send" data-send type="submit">Send</button>
  </form>
</aside>

<div class="shopper-strip" data-strip>
  <div class="shopper-strip__live"><i></i>LIVE</div>
  <div class="shopper-strip__lamps">
    <div class="shopper-strip__lamp" data-p="google"><span></span>Gemini</div>
    <div class="shopper-strip__lamp" data-p="databricks"><span></span>Databricks</div>
    <div class="shopper-strip__lamp" data-p="bloomreach"><span></span>Bloomreach</div>
    <div class="shopper-strip__lamp" data-p="shopify"><span></span>Shopify</div>
  </div>
  <div class="shopper-strip__ticker" data-ticker>idle · waiting for a shopper</div>
  <button type="button" class="shopper-strip__bts" data-bts aria-expanded="false" aria-controls="ShopperBts">Behind the scenes <b>▴</b></button>
</div>

<div class="shopper-bts" id="ShopperBts" data-bts-panel aria-label="Behind the scenes" role="region" inert>
  <section class="shopper-bts__sec">
    <h4>Platforms · live</h4>
    <div class="shopper-bts__lamp" data-p="google"><span></span><b>Google Gemini</b><em>idle</em></div>
    <div class="shopper-bts__lamp" data-p="databricks"><span></span><b>Databricks</b><em>idle</em></div>
    <div class="shopper-bts__lamp" data-p="bloomreach"><span></span><b>Bloomreach</b><em>idle</em></div>
    <div class="shopper-bts__lamp" data-p="shopify"><span></span><b>Shopify</b><em>idle</em></div>
  </section>
  <section class="shopper-bts__sec">
    <h4>Customer profile</h4>
    <div data-bts-profile></div>
  </section>
  <section class="shopper-bts__sec">
    <h4>Agent tool calls · last turn</h4>
    <div class="shopper-bts__trace" data-bts-trace></div>
  </section>
  <section class="shopper-bts__sec">
    <h4>Post-purchase journey</h4>
    <div data-bts-journey></div>
  </section>
</div>

<script src="{{ 'shopper.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Personal shopper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your personal shopper" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Describe a room. The page builds around it." },
    {
      "type": "text",
      "id": "agent_url",
      "label": "Agent URL",
      "info": "Base URL of the shopping agent. The chat posts to {url}/api/chat.",
      "default": "https://t6-discovery-agent-gk6oiw33qq-uc.a.run.app"
    }
  ]
}
{% endschema %}
